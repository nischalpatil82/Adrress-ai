<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS deployment config for Address AI (Windows Server 2019, HttpPlatformHandler).

  This file is intended to live at the site root on the server, e.g.:
      C:\inetpub\address_ai\web.config

  It tells IIS's HttpPlatformHandler module to launch Waitress (run_production.py)
  inside this app's own virtual environment and proxy requests to it on a private,
  IIS-assigned port (%HTTP_PLATFORM_PORT%). The app stays bound to 127.0.0.1 and is
  only reachable through IIS.

  If you deploy to a different path, update processPath / arguments / stdoutLogFile /
  HF_HOME below to match.

  Notes:
    - The app pool for this site MUST be "No Managed Code" (this is a Python app).
    - Create the logs\ folder and grant the app pool identity write access to it.
    - requestTimeout is generous because V2_LAZY_LOAD=1 loads the ML models on the
      first request, which is slow on a memory-constrained box.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Users\User\Desktop\address_ai1\.venv\Scripts\python.exe" arguments="C:\Users\User\Desktop\address_ai1\run_production.py" stdoutLogEnabled="true" stdoutLogFile="C:\Users\User\Desktop\address_ai1\logs\stdout.log" startupTimeLimit="120" requestTimeout="00:20:00">
      <environmentVariables>
        <!-- IIS assigns a private port; map it to the app's PORT env var. -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOST" value="127.0.0.1" />
        <!-- Load ML models lazily on first request to keep startup fast. -->
        <environmentVariable name="V2_LAZY_LOAD" value="1" />
        <!-- Match the known-good HuggingFace config; also saves ~300-350 MB RAM. -->
        <environmentVariable name="V2_USE_T5" value="0" />
        <!-- No MySQL on this server; SQL retrieval is an optional extra source. -->
        <environmentVariable name="V2_USE_SQL_DB" value="0" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- Point HuggingFace at a project-local cache so it works under any identity. -->
        <environmentVariable name="HF_HOME" value="C:\Users\User\Desktop\address_ai1\hf_cache" />
        <environmentVariable name="HF_HUB_OFFLINE" value="1" />
        <environmentVariable name="TRANSFORMERS_OFFLINE" value="1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>